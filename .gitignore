# Playground .gitignore
# This file defines what is project-specific (generated by AI) vs framework (tracked in git)

# ============================================================================
# GENERATED FILES (project-specific, not tracked)
# ============================================================================

# Nested dependency install — created locally by setup.mjs (local-dev only).
# Keeps deps out of the host repo even if this folder itself is tracked.
/node_modules/
# Lockfile from the nested Bun install — intentionally not committed (local-dev only).
/bun.lock
/bun.lockb
# npm lockfile is redundant here — the project standardizes on Bun (see setup.mjs).
/package-lock.json

# Generated iteration files - AI creates these when iterating on components
iterations/*.iteration-*.tsx
iterations/iterations-images/*

# Generated API routes for component-specific data fetching
# AI creates these when a component needs live data (e.g., api/insights/route.ts)

previews/

# Discovered-registry artifacts — per-project, never tracked.
# The manifest is written by discovery inside a host project, and the .gen.tsx
# module is derived from it; a framework checkout has neither. `ensureModuleExists`
# (server/lib/discovered-registry.ts) writes an empty .gen.tsx at server boot so
# registry.tsx's static import always resolves.
discovered-registry.json
discovered-registry.gen.tsx
data/*.mockData.ts

# Skill markdown installed into the host project — matched at any depth, so it
# also covers .claude/skills/ and .agents/skills/.
skills/
# ...but features/skills/ is this package's own source. Without this negation
# the rule above silently ignores any new file added to that feature.
!/features/skills/

# Eval harness run artifacts (per-run, not tracked)
evals/runs/

# Scratch dir for delegated-agent briefs and their raw output (Cursor CLI, etc.).
# Anything worth keeping gets copied into .claude/plans/research/.
tasks/

# Personal scratchpad — never tracked.
DRAFT.md

# graphify code-graph snapshot (regenerated by `graphify extract`; goes stale after edits).
graphify-out/

# ============================================================================
# FRAMEWORK FILES (tracked in git)
# ============================================================================
# The following are explicitly NOT ignored (they are the playground framework):
#
# - dev-entry.tsx               React-router mount entry
# - registry.tsx                Types, helpers, empty registry template
# - app/                        Composition shell (PlaygroundClient/Canvas/Header/Sidebar)
# - features/                   Feature modules (canvas, iterations, chat, ...)
# - shared/                     Cross-feature ui/, lib/, stores/
# - docs/                       AI instructions and documentation
# - iterations/index.ts         Template for iteration registration
# - server/routes/iterations.ts Core API for managing iterations
