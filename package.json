{
  "name": "design-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Local-dev design playground. Its dependencies install NESTED under src/app/playground/node_modules (see SETUP.md) so the host project's package.json and lockfile are never touched. Local-dev only — never built in CI/prod. Vite-compatible. react/react-dom/tailwindcss are provided by the host (peerDependencies).",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hono/node-server": "^1.19.14",
    "@tailwindcss/typography": "^0.5.20",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "hono": "^4.12.27",
    "lucide-react": "^1.17.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "5",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4",
    "vite": "^5 || ^6"
  },
  "scripts": {
    "check:boundaries": "bunx --bun dependency-cruiser@16 --config .dependency-cruiser.cjs --ts-config tsconfig.json \"app/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"server/**/*.{ts,tsx}\" registry.tsx dev-entry.tsx",
    "check:knip": "bunx knip --config knip.json",
    "check:architecture": "bun scripts/verify-architecture.mjs"
  }
}
